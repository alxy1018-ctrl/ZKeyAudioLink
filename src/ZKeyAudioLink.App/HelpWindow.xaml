<Window x:Class="ZKeyAudioLink.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助 · Z 键音频连麦"
        Width="780" Height="660" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Icon="Assets/app.ico"
        FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <TextBlock Text="它是怎么工作的" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="{StaticResource TextSecondary}"
                           Text="软件把真实麦克风和当前选中的音频在内部混音，写入虚拟声卡 CABLE Input。QQ / OOPZ 从 CABLE Output 读取，所以对方会同时听到你的说话和素材。素材另有一路只送到你的耳机，本机不会听到自己的延迟人声。" />

                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="路由" Style="{StaticResource SectionTitle}" />
                        <TextBlock Margin="0,10,0,0" FontFamily="Consolas" FontSize="12.5" LineHeight="22" Foreground="{StaticResource TextPrimary}">
                            <Run Text="真实麦克风 ─┐" /><LineBreak />
                            <Run Text="               ├→ 混音 → CABLE Input → CABLE Output → QQ / OOPZ" /><LineBreak />
                            <Run Text="选中的音频 ───┘" /><LineBreak />
                            <Run Text="      └────────→ 耳机监听（只有素材，没有人声）" />
                        </TextBlock>
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   Text="不要开启 Windows 录音设备属性里的“侦听此设备”，也不要把系统默认播放设备改成 CABLE Input，否则容易产生回声或重复播放。" />
                    </StackPanel>
                </Border>

                <TextBlock Text="第一次使用" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,20,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondary}">
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="1. 安装驱动。" />
                    <Run Text="到 vb-audio.com/Cable 下载基础版 VB-CABLE（不要选 A+B / C+D），完整解压后按官方说明以管理员身份安装并重启。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="2. 选择设备。" />
                    <Run Text="本软件的“真实麦克风”选择你实际使用的麦克风，“耳机输出”选择耳机，“虚拟发送端”选择 CABLE Input。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="3. 配置通话软件。" />
                    <Run Text="QQ / OOPZ 的麦克风（输入）选 CABLE Output，扬声器（输出）保持耳机。不要静音，不要把输入选成 CABLE Input。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="4. 试音。" />
                    <Run Text="导入音频、选中条目、设置开始时间，然后按播放快捷键（默认 Z，可在主界面改成其他单键）并同时说话。请对方确认素材和人声都能听到。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="5. 退出前。" />
                    <Run Text="先停止素材，再把 QQ / OOPZ 的麦克风切回真实麦克风，最后从托盘退出本软件。" />
                </TextBlock>

                <TextBlock Text="常见问题" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,20,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondary}">
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="对方听不到素材：" />
                    <Run Text="检查音频发送音量、虚拟发送端是否为 CABLE Input、QQ / OOPZ 输入是否为 CABLE Output，以及通话是否处于按键说话模式。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="对方听不到你说话：" />
                    <Run Text="检查麦克风选择、Windows 麦克风隐私权限、麦克风增益和左侧麦克风电平。停止素材不应该让麦克风静音。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="对方听到自己的回声：" />
                    <Run Text="确认通话软件的输出是耳机；关闭 Windows 的“侦听”；不要捕获系统回放。" /><LineBreak /><LineBreak />
                    <Run FontWeight="SemiBold" Foreground="#16213A" Text="快捷键没反应或连续触发：" />
                    <Run Text="确认顶部全局快捷键开关打开，并在播放区选好按键。只支持主键盘区单键，Shift / Ctrl / Alt 不改变匹配；长按只触发一次。锁屏、UAC 安全桌面和部分游戏/管理员窗口可能拦截后台按键，这类情况不在承诺范围内。" />
                </TextBlock>

                <TextBlock Text="授权与隐私" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,20,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondary}"
                           Text="VB-CABLE 基础版是 VB-Audio 的捐赠软件：功能可免费使用，厂商希望觉得有用时捐赠，专业用途需要付费授权。本软件不捆绑驱动、不静默安装、不修改系统默认音频设备，也不录制通话或记录键盘内容。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button Content="关闭" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="96"
                    Click="Close_Click" IsCancel="True" />
        </Border>
    </Grid>
</Window>
