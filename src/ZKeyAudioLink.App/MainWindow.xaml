<Window x:Class="ZKeyAudioLink.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z 键音频连麦"
        Width="1160" Height="900" MinWidth="980" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Icon="Assets/app.ico"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Accent}">
                        <TextBlock Text="Z" Foreground="White" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Z 键音频连麦" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="麦克风 + 本地音频 → 虚拟声卡" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="Medium"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                               ToolTip="{Binding StatusDetail}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="全局 Z" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding HotkeyEnabled, Mode=TwoWay}" />
                </StackPanel>

                <Button Grid.Column="3" Content="帮助" Style="{StaticResource SecondaryButton}" Padding="16,7" Click="HelpButton_Click" />
            </Grid>
        </Border>

        <!-- Banner -->
        <Border Grid.Row="1" Margin="22,12,22,0" Padding="14,10" CornerRadius="10"
                Background="#FFFBEB" BorderBrush="{Binding BannerBrush}" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontSize="13" Foreground="#7A4E00" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="×" Command="{Binding DismissBannerCommand}" Style="{StaticResource TextButton}"
                        FontSize="16" Padding="8,0" Margin="12,0,0,0" Foreground="#7A4E00" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="2" Margin="22,16,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="372" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Media library -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="音频库" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Button Content="+ 导入" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                Command="{Binding ImportCommand}" Padding="12,6" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding MediaItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource MediaItemStyle}" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" Padding="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding StartText}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource DangerSoft}" CornerRadius="6" Padding="6,2"
                                                VerticalAlignment="Top" Visibility="{Binding IsMissing, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="文件缺失" Foreground="{StaticResource Danger}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="还没有音频。点击右上角“导入”添加 WAV 或 MP3。"
                                   FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240" TextAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedia}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Grid.Row="2" Content="从应用库删除" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"
                            Command="{Binding DeleteCommand}" />
                </Grid>
            </Border>

            <!-- Right column -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Playback -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="当前音频" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding SelectedName}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedMeta}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource AccentSoft}"
                                        CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="全局按 Z 播放 / 停止" FontSize="12" Foreground="{StaticResource Accent}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="124" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开始时间" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox x:Name="StartTimeBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                         Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="StartTimeBox_LostFocus" KeyDown="StartTimeBox_KeyDown"
                                         HorizontalContentAlignment="Left" />
                                <Slider Grid.Column="2" Margin="16,0,4,0" Minimum="0" Maximum="{Binding StartSliderMax}"
                                        Value="{Binding StartSeconds, Mode=TwoWay}" IsMoveToPointEnabled="True" />
                            </Grid>

                            <TextBlock Text="{Binding StartTimeError}" Foreground="{StaticResource Danger}" FontSize="12"
                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasStartTimeError, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="当前播放位置" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Right" Style="{StaticResource MonoText}" />
                            </Grid>

                            <Button Command="{Binding PlayStopCommand}" Style="{StaticResource PrimaryButton}" Height="56" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PlayGlyph}" FontSize="17" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PlayButtonText}" FontSize="17" VerticalAlignment="Center" />
                                    <TextBlock Text="（Z）" FontSize="12" Opacity="0.75" Margin="8,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="音频发送音量" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding SendGainPercent, StringFormat={}{0:0}%}" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="200" Value="{Binding SendGainPercent, Mode=TwoWay}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="本地监听音量" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding MonitorGainPercent, StringFormat={}{0:0}%}" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="200" Value="{Binding MonitorGainPercent, Mode=TwoWay}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Devices -->
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="音频设备" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDevicesCommand}"
                                            Padding="12,6" Margin="0,0,8,0" />
                                    <Button Content="重新连接" Style="{StaticResource SecondaryButton}" Command="{Binding ReconnectCommand}"
                                            Padding="12,6" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="106" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="真实麦克风" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Grid.Row="2" Text="耳机输出" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding MonitorDevices}" SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <TextBlock Grid.Row="4" Text="虚拟发送端" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding VirtualDevices}" SelectedItem="{Binding SelectedVirtual, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                            </Grid>

                            <Border Background="{StaticResource SurfaceMuted}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DeviceHint}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="麦克风电平" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding MicLevelText}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding MicLevel, Mode=OneWay}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="素材电平" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding MaterialLevelText}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding MaterialLevel, Mode=OneWay}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Grid>
                                        <TextBlock Text="混音输出" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding MixLevelText}" FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource LevelBar}" Value="{Binding MixLevel, Mode=OneWay}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="麦克风增益" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding MicGainPercent, Mode=TwoWay}" Margin="14,0,14,0" />
                                <TextBlock Grid.Column="2" Text="{Binding MicGainPercent, StringFormat={}{0:0}%}" FontSize="12" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="打开日志文件夹" Style="{StaticResource TextButton}" Command="{Binding OpenLogsCommand}" Padding="0,3" />
                                <TextBlock Text="·" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                <Button Content="VB-CABLE 下载页" Style="{StaticResource TextButton}" Command="{Binding OpenDriverPageCommand}" Padding="0,3" />
                                <TextBlock Text="第一次配置请点右上角“帮助”" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="18,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,9">
            <Grid>
                <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}" Margin="0,0,16,0" />
                <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center">
                    <Run Text="v" /><Run Text="{Binding AppVersion, Mode=OneWay}" /><Run Text=" · 停止素材不会中断麦克风转发" />
                </TextBlock>
            </Grid>
        </Border>

        <!-- Busy overlay -->
        <Border Grid.RowSpan="4" Background="#B3FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Background="White" CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Width="260">
                    <TextBlock Text="{Binding BusyText}" FontSize="14" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Background="#EDF1F7" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>



